generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id          Int      @id @default(autoincrement())
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  name        String   @db.Text
  cell        String   @unique @db.Text
  telephone   String?  @db.Text
  observation String?  @db.Text

  vehicles      Vehicle[]
  serviceOrders ServiceOrder[]
  user          User?

  @@map("customer")
}

model Vehicle {
  id            Int      @id @default(autoincrement())
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  license_plate String   @unique @db.Text
  brand         String?  @db.Text
  model         String?  @db.Text
  year          Int?
  color         String?  @db.Text
  customer_id   Int?

  // Relacionamentos
  customer      Customer?      @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  serviceOrders ServiceOrder[]

  @@map("vehicle")
}

model MaterialGroup {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)
  group      String   @unique @db.Text

  materials Material[] // Relacionamento inverso

  @@map("material_group")
}

model Material {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)
  name       String   @unique @db.Text
  group_id   Int

  // Relacionamentos
  group         MaterialGroup  @relation(fields: [group_id], references: [id], onDelete: Cascade)
  itemMaterials ItemMaterial[] // Relacionamento inverso

  @@map("material")
}

model MaintenanceJobGroup {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)
  group      String   @unique @db.Text

  maintenanceJobs MaintenanceJob[] // Relacionamento inverso

  @@map("maintenancejob_group")
}

model MaintenanceJob {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)
  name       String   @unique @db.Text
  group_id   Int

  // Relacionamentos
  group            MaintenanceJobGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)
  itemMaintenances ItemMaintenance[] // Relacionamento inverso

  @@map("maintenancejob")
}

model ServiceOrder {
  id            Int       @id @default(autoincrement())
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  professional  String?   @db.Text
  status        Int?
  paymentStatus Int?      @default(1)
  arrived_at    DateTime? @default(now()) @db.Timestamptz(6)
  customer_id   Int
  vehicle_id    Int
  entry_km      Decimal   @default(0) @db.Decimal(10, 2)
  diagnosis     String?   @db.Text
  observation   String?   @db.Text

  labor_cost Decimal @default(0) @db.Decimal(10, 2)
  subtotal   Decimal @default(0) @db.Decimal(10, 2)
  paid       Decimal @default(0) @db.Decimal(10, 2)

  // Relacionamentos
  customer         Customer          @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  vehicle          Vehicle           @relation(fields: [vehicle_id], references: [id], onDelete: Restrict)
  itemMaterials    ItemMaterial[]
  itemMaintenances ItemMaintenance[]

  @@map("serviceorder")
}

model ItemMaterial {
  id                 Int      @id @default(autoincrement())
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  quantity           Int      @default(1)
  value_unit         Decimal  @default(0) @db.Decimal(10, 2)
  serviceorder_id    Int
  itemMaintenance_id Int?
  material_id        Int
  receipt            String?  @db.Text
  supplier           String?  @db.Text
  isCustomerSupplier Boolean? @default(false)

  // Relacionamentos
  serviceorder    ServiceOrder     @relation(fields: [serviceorder_id], references: [id], onDelete: Cascade)
  itemmaintenance ItemMaintenance? @relation(fields: [itemMaintenance_id], references: [id], onDelete: Cascade)
  material        Material         @relation(fields: [material_id], references: [id], onDelete: Restrict)

  @@map("item_material")
}

model ItemMaintenance {
  id              Int      @id @default(autoincrement())
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  serviceorder_id Int
  maintenance_id  Int?
  description     String?  @db.Text

  // Relacionamentos
  serviceorder   ServiceOrder    @relation(fields: [serviceorder_id], references: [id], onDelete: Cascade)
  maintenancejob MaintenanceJob? @relation(fields: [maintenance_id], references: [id], onDelete: Restrict)
  itemMaterials  ItemMaterial[]

  @@map("item_maintenance")
}

enum Role {
  ADMIN
  CUSTOMER
}

model User {
  id            Int      @id @default(autoincrement())
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  email         String   @unique @db.Text
  name          String   @db.Text
  password_hash String   @db.Text
  role          Role     @default(ADMIN)
  is_active     Boolean  @default(true)

  // Relacionamento opcional para quando o cliente do sistema ganhar um acesso no futuro
  customer_id Int?      @unique
  customer    Customer? @relation(fields: [customer_id], references: [id], onDelete: SetNull)

  @@map("users")
}
