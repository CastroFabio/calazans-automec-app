// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
}

datasource db {
  provider = "sqlite"
}

model Customer {
  id    Int     @default(autoincrement()) @id
  cell Int  @unique @default(00000000)
  phone  Int @unique
  name  String?

  cars Car[]

  orders Order[]
}

model Car {
  id    Int     @default(autoincrement()) @id
  type String  
  license_plate  String @unique
  brand String
  model String
  year Int
  color String
  km Int
  arrived_at DateTime @default(now())
  car_owner    Customer?    @relation(fields: [customer_id], references: [id])
  customer_id Int?

  orders Order[]
}

enum Status {
  in_progress
  pending
  done
}

enum Priority {
  alta
  normal
  baixa
}

model Order {
  id    Int     @default(autoincrement()) @id
  employer String
  priority Priority @default(normal) 
  status Status @default(pending)
  total_value Decimal
  description String?
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  customer     Customer?    @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  customer_id Int?

  car     Car?    @relation(fields: [car_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  car_id Int?

  itemMaintenance Item_Maintenance[]

  itemMaterials Item_Material[]
}

model Item_Maintenance{
  id    Int     @default(autoincrement()) @id
  value_unit Decimal
  subtotal Decimal
  quantidade Int

  order     Order?    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  order_id Int?

  maintenance     Maintenance?    @relation(fields: [maintenance_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  maintenance_id Int?
}

model Item_Material{
  id    Int     @default(autoincrement()) @id
  value_unit Decimal
  subtotal Decimal
  quantidade Int

  order     Order?    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  order_id Int?

  material     Material?    @relation(fields: [material_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  material_id Int?
}

model Maintenance {
  id    Int     @default(autoincrement()) @id
  name String   @unique
  value_price Decimal

  group     Group?    @relation(fields: [group_id], references: [id])
  group_id Int?

  itemMaintenance Item_Maintenance[]

}

model Material {
  id    Int     @default(autoincrement()) @id
  name String   @unique
  value_price Decimal

  group     Group?    @relation(fields: [group_id], references: [id])
  group_id Int?

  itemMaterials Item_Material[]

}

model Group {
  id Int     @default(autoincrement()) @id
  name String   @unique

  maintenance Maintenance[]

  materials Material[]
}